PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIRECTORY=./data
ADMIN_EMAILS=your-signup-email@example.com

# Actual registered seller country. Leave LK unless your business is registered elsewhere.
BUSINESS_COUNTRY=LK

# Paddle seller approval and the Sri Lanka bank/Payoneer payout route must be confirmed
# with Paddle before enabling live billing. Start with sandbox credentials only.
PADDLE_ENV=sandbox
PADDLE_MERCHANT_APPROVED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=

# Stripe is retained only for a seller with a real Stripe-eligible business country.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
